@dataclass(frozen=True)
class Price:
    """US dollars per million tokens."""

    input: float
    output: float
    cache_read: float


# Anthropic API list prices, from the claude-api skill's model table (cached 2026-10-06).
# Cache writes cost 1.25x the input price for the 5-minute TTL and 2x for the 1-hour TTL.
PRICES: dict[str, Price] = {
    "claude-fable-5-1": Price(10.00, 50.00, 0.25),
    "claude-mythos-5-1": Price(10.00, 50.00, 0.25),
    "claude-fable-5": Price(10.00, 50.00, 1.00),
    "claude-mythos-5": Price(10.00, 50.00, 1.00),
    "claude-opus-5-5": Price(4.00, 20.00, 0.20),
    "claude-opus-5": Price(5.00, 25.00, 0.50),
    "claude-opus-4-8": Price(5.00, 25.00, 0.50),
    "claude-opus-4-7": Price(5.00, 25.00, 0.50),
    "claude-opus-4-6": Price(5.00, 25.00, 0.50),
    "claude-sonnet-5-5": Price(2.00, 10.00, 0.20),
    "claude-sonnet-5": Price(2.00, 10.00, 0.20),
    "claude-sonnet-4-6": Price(3.00, 15.00, 0.30),
    "claude-haiku-5-5": Price(0.10, 0.50, 0.01),
    "claude-haiku-4-5": Price(1.00, 5.00, 0.10),
}
# Claude Haiku 5.5 charges more once the prompt passes 100K tokens.
HAIKU_5_5_LONG = Price(0.50, 2.50, 0.05)
HAIKU_5_5_LONG_PROMPT = 100_000
CACHE_WRITE_5M = 1.25
CACHE_WRITE_1H = 2.0
FAST_MODE = 2.0


@dataclass(frozen=True)
class Reply:
    """One API response as logged by Claude Code."""

    key: str
    when: datetime
    model: str
    session: str
    project: str
    input: int
    output: int
    cache_write: int
    cache_write_1h: int
    cache_read: int
    fast: bool
    # Forked subagent logs can copy a reply while it is still streaming: same key, partial usage.
    finished: bool

    def better_than(self, other: Reply) -> bool:
        return (self.finished, self.output) > (other.finished, other.output)

    def cost(self) -> float | None:
        """API list price of this reply in US dollars, or None for a model without a known price."""
        price = PRICES.get(re.sub(r"(-\d{8}|\[\w+\])$", "", self.model))
        if price is None:
            return None
        prompt = self.input + self.cache_write + self.cache_read
        if self.model.startswith("claude-haiku-5-5") and prompt > HAIKU_5_5_LONG_PROMPT:
            price = HAIKU_5_5_LONG
        cache_write_5m = self.cache_write - self.cache_write_1h
        dollars = (
            self.input * price.input
            + self.output * price.output
            + cache_write_5m * price.input * CACHE_WRITE_5M
            + self.cache_write_1h * price.input * CACHE_WRITE_1H
            + self.cache_read * price.cache_read
        ) / 1_000_000
        return dollars * FAST_MODE if self.fast else dollars


@dataclass
class Totals:
    replies: int = 0
    input: int = 0
    output: int = 0
    cache_write: int = 0
    cache_read: int = 0
    cost: float = 0.0
    unpriced: int = 0
    last: datetime = field(default_factory=lambda: datetime.min.replace(tzinfo=UTC))

    def add(self, r: Reply) -> None:
        self.replies += 1
        self.input += r.input
        self.output += r.output
        self.cache_write += r.cache_write
        self.cache_read += r.cache_read
        cost = r.cost()
        if cost is None:
            self.unpriced += 1
        else:
            self.cost += cost
        self.last = max(self.last, r.when)

    def merge(self, other: Totals) -> None:
        self.replies += other.replies
        self.input += other.input
        self.output += other.output
        self.cache_write += other.cache_write
        self.cache_read += other.cache_read
        self.cost += other.cost
        self.unpriced += other.unpriced
        self.last = max(self.last, other.last)

    @property
    def total(self) -> int:
        return self.input + self.output + self.cache_write + self.cache_read


@dataclass(frozen=True)
class Window:
    """One of the account's rolling usage limits."""

    name: str
    percent: float
    starts: datetime
    resets: datetime


@dataclass(frozen=True)
class Limits:
    plan: str
    windows: tuple[Window, ...]
    # Part of the account's usage that comes from Claude Code rather than chats or other apps.
    claude_code_fraction: float


@dataclass(frozen=True)
class Machine:
    """A tailnet device that can run Claude Code."""

    name: str
    ips: tuple[str, ...]
    online: bool
    is_self: bool

    def matches(self, host: str) -> bool:
        return host == self.name or host in self.ips or (host == "local" and self.is_self)


class FetchError(Exception):
    pass


# json.loads returns untyped values; these helpers narrow them so the rest of the file stays typed.
def as_dict(value: object) -> dict[str, object]:
    return {k: v for k, v in value.items() if isinstance(k, str)} if isinstance(value, dict) else {}


def as_list(value: object) -> list[object]:
    return list(value) if isinstance(value, list) else []


def as_int(value: object) -> int:
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


def as_float(value: object) -> float | None:
    return float(value) if isinstance(value, int | float) and not isinstance(value, bool) else None


def as_str(value: object) -> str:
    return value if isinstance(value, str) else ""


def as_time(value: object) -> datetime | None:
    try:
        return datetime.fromisoformat(as_str(value).replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None


def parse_reply(line: str) -> Reply | None:
    try:
        record = as_dict(json.loads(line))
    except json.JSONDecodeError:
        return None
    message = as_dict(record.get("message"))
    usage = as_dict(message.get("usage"))
    model = as_str(message.get("model"))
    # API errors and <synthetic> placeholders are logged as replies with zero usage.
    is_real_reply = record.get("type") == "assistant" and bool(usage) and model != "<synthetic>"
    when = as_time(record.get("timestamp"))
    if not is_real_reply or when is None:
        return None
    cwd = as_str(record.get("cwd"))
    return Reply(
        # Claude Code writes one line per content block, all repeating the same message id and usage.
        key=f"{as_str(message.get('id'))}:{as_str(record.get('requestId'))}",
        when=when,
        model=model or "unknown",
        session=as_str(record.get("sessionId")),
        project=re.split(r"[\\/]", cwd.rstrip("\\/"))[-1] if cwd else "unknown",
        input=as_int(usage.get("input_tokens")),
        output=as_int(usage.get("output_tokens")),
        cache_write=as_int(usage.get("cache_creation_input_tokens")),
        cache_write_1h=as_int(as_dict(usage.get("cache_creation")).get("ephemeral_1h_input_tokens")),
        cache_read=as_int(usage.get("cache_read_input_tokens")),
        fast=usage.get("speed") == "fast",
        finished=message.get("stop_reason") is not None,
    )


# Runs on the machine that holds the Claude login, so its token never leaves it. This is the
# endpoint Claude Code's /usage screen reads. Prints one line: LIMITS_MARK + JSON.
LIMITS_SCRIPT = r"""
import json, os, platform, subprocess, time, urllib.request
def credentials():
    if platform.system() == "Darwin":
        try:
            found = subprocess.run(["security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                                   capture_output=True, text=True, timeout=5)
            if found.returncode == 0 and found.stdout.strip():
                return json.loads(found.stdout)
        except (OSError, subprocess.SubprocessError, ValueError):
            pass
    root = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    with open(os.path.join(root, ".credentials.json")) as f:
        return json.load(f)
try:
    oauth = credentials().get("claudeAiOauth") or {}
    if not oauth.get("accessToken"):
        raise RuntimeError("no Claude login on this machine")
    if oauth.get("expiresAt", 0) <= time.time() * 1000:
        raise RuntimeError("the Claude login token expired; Claude Code renews it on its next run")
    request = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
        "Authorization": "Bearer " + oauth["accessToken"], "anthropic-beta": "oauth-2025-04-20"})
    with urllib.request.urlopen(request, timeout=15) as response:
        out = {"plan": oauth.get("rateLimitTier") or oauth.get("subscriptionType") or "", "usage": json.load(response)}
except Exception as error:
    out = {"error": str(error) or type(error).__name__}
print("#tokens-limits " + json.dumps(out))
"""

