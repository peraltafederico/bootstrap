@dataclass(frozen=True)
class Price:
    """US dollars per million tokens."""

    input: float
    output: float
    cache_read: float


# Anthropic API list prices, from the claude-api skill's model table (cached 2026-10-06).
# Cache writes cost 1.25x the input price for the 5-minute TTL and 2x for the 1-hour TTL.
PRICES: dict[str, Price] = {
    "claude-fable-5-1": Price(10.00, 50.00, 0.25),
    "claude-mythos-5-1": Price(10.00, 50.00, 0.25),
    "claude-fable-5": Price(10.00, 50.00, 1.00),
    "claude-mythos-5": Price(10.00, 50.00, 1.00),
    "claude-opus-5-5": Price(4.00, 20.00, 0.20),
    "claude-opus-5": Price(5.00, 25.00, 0.50),
    "claude-opus-4-8": Price(5.00, 25.00, 0.50),
    "claude-opus-4-7": Price(5.00, 25.00, 0.50),
    "claude-opus-4-6": Price(5.00, 25.00, 0.50),
    "claude-sonnet-5-5": Price(2.00, 10.00, 0.20),
    "claude-sonnet-5": Price(2.00, 10.00, 0.20),
    "claude-sonnet-4-6": Price(3.00, 15.00, 0.30),
    "claude-haiku-5-5": Price(0.10, 0.50, 0.01),
    "claude-haiku-4-5": Price(1.00, 5.00, 0.10),
}
# Claude Haiku 5.5 charges more once the prompt passes 100K tokens.
HAIKU_5_5_LONG = Price(0.50, 2.50, 0.05)
HAIKU_5_5_LONG_PROMPT = 100_000
CACHE_WRITE_5M = 1.25
CACHE_WRITE_1H = 2.0
FAST_MODE = 2.0
# A billing cycle is at most 31 days, so reading 32 days back always covers it.
CYCLE_READ = timedelta(days=32)


@dataclass(frozen=True)
class Reply:
    """One API response as logged by Claude Code."""

    key: str
    when: datetime
    model: str
    session: str
    project: str
    input: int
    output: int
    cache_write: int
    cache_write_1h: int
    cache_read: int
    fast: bool
    # Forked subagent logs can copy a reply while it is still streaming: same key, partial usage.
    finished: bool

    def better_than(self, other: Reply) -> bool:
        return (self.finished, self.output) > (other.finished, other.output)

    def cost(self) -> float | None:
        """API list price of this reply in US dollars, or None for a model without a known price."""
        price = PRICES.get(re.sub(r"(-\d{8}|\[\w+\])$", "", self.model))
        if price is None:
            return None
        prompt = self.input + self.cache_write + self.cache_read
        if self.model.startswith("claude-haiku-5-5") and prompt > HAIKU_5_5_LONG_PROMPT:
            price = HAIKU_5_5_LONG
        cache_write_5m = self.cache_write - self.cache_write_1h
        dollars = (
            self.input * price.input
            + self.output * price.output
            + cache_write_5m * price.input * CACHE_WRITE_5M
            + self.cache_write_1h * price.input * CACHE_WRITE_1H
            + self.cache_read * price.cache_read
        ) / 1_000_000
        return dollars * FAST_MODE if self.fast else dollars


@dataclass
class Totals:
    replies: int = 0
    input: int = 0
    output: int = 0
    cache_write: int = 0
    cache_read: int = 0
    cost: float = 0.0
    unpriced: int = 0
    last: datetime = field(default_factory=lambda: datetime.min.replace(tzinfo=UTC))

    def add(self, r: Reply) -> None:
        self.replies += 1
        self.input += r.input
        self.output += r.output
        self.cache_write += r.cache_write
        self.cache_read += r.cache_read
        cost = r.cost()
        if cost is None:
            self.unpriced += 1
        else:
            self.cost += cost
        self.last = max(self.last, r.when)

    def merge(self, other: Totals) -> None:
        self.replies += other.replies
        self.input += other.input
        self.output += other.output
        self.cache_write += other.cache_write
        self.cache_read += other.cache_read
        self.cost += other.cost
        self.unpriced += other.unpriced
        self.last = max(self.last, other.last)

    @property
    def total(self) -> int:
        return self.input + self.output + self.cache_write + self.cache_read


@dataclass(frozen=True)
class Window:
