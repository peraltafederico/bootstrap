#!/usr/bin/env python3
"""tokens: show how many Claude Code tokens a machine has used.

  tokens                          this machine, last 7 days, by day
  tokens federicos-windows        a mesh machine over SSH (macOS, Linux or Windows)
  tokens --since today --by session
  tokens win --watch 60           refresh every 60 seconds

Claude Code logs every reply, with its token usage, to ~/.claude/projects/**/*.jsonl.
tokens reads those logs (over SSH for other machines) and adds them up.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import re
import subprocess
import sys
import time
from collections.abc import Iterable, Iterator
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
from pathlib import Path

GROUPINGS = ("day", "model", "session", "project")


@dataclass(frozen=True)
class Reply:
    """One API response as logged by Claude Code."""

    key: str
    when: datetime
    model: str
    session: str
    project: str
    input: int
    output: int
    cache_write: int
    cache_read: int


@dataclass
class Totals:
    replies: int = 0
    input: int = 0
    output: int = 0
    cache_write: int = 0
    cache_read: int = 0
    last: datetime = field(default_factory=lambda: datetime.min.replace(tzinfo=UTC))

    def add(self, r: Reply) -> None:
        self.replies += 1
        self.input += r.input
        self.output += r.output
        self.cache_write += r.cache_write
        self.cache_read += r.cache_read
        self.last = max(self.last, r.when)

    def merge(self, other: Totals) -> None:
        self.replies += other.replies
        self.input += other.input
        self.output += other.output
        self.cache_write += other.cache_write
        self.cache_read += other.cache_read
        self.last = max(self.last, other.last)

    @property
    def total(self) -> int:
        return self.input + self.output + self.cache_write + self.cache_read


# json.loads returns untyped values; these helpers narrow them so the rest of the file stays typed.
def as_dict(value: object) -> dict[str, object]:
    return {k: v for k, v in value.items() if isinstance(k, str)} if isinstance(value, dict) else {}


def as_int(value: object) -> int:
    return value if isinstance(value, int) and not isinstance(value, bool) else 0


def as_str(value: object) -> str:
    return value if isinstance(value, str) else ""


def parse_reply(line: str) -> Reply | None:
    try:
        record = as_dict(json.loads(line))
    except json.JSONDecodeError:
        return None
    message = as_dict(record.get("message"))
    usage = as_dict(message.get("usage"))
    is_logged_reply = record.get("type") == "assistant" and bool(usage)
    if not is_logged_reply:
        return None
    try:
        when = datetime.fromisoformat(as_str(record.get("timestamp")).replace("Z", "+00:00")).astimezone()
    except ValueError:
        return None
    cwd = as_str(record.get("cwd"))
    return Reply(
        # Claude Code writes one line per content block, all repeating the same message id and usage.
        key=f"{as_str(message.get('id'))}:{as_str(record.get('requestId'))}",
        when=when,
        model=as_str(message.get("model")) or "unknown",
        session=as_str(record.get("sessionId")),
        project=re.split(r"[\\/]", cwd.rstrip("\\/"))[-1] if cwd else "unknown",
        input=as_int(usage.get("input_tokens")),
        output=as_int(usage.get("output_tokens")),
        cache_write=as_int(usage.get("cache_creation_input_tokens")),
        cache_read=as_int(usage.get("cache_read_input_tokens")),
    )


def windows_script(cutoff: datetime) -> str:
    return f"""
$ProgressPreference = 'SilentlyContinue'
[Console]::OutputEncoding = [Text.Encoding]::UTF8
$root = Join-Path $env:USERPROFILE '.claude\\projects'
if (Test-Path $root) {{
  Get-ChildItem $root -Recurse -Filter *.jsonl -File |
    Where-Object {{ $_.LastWriteTime -ge [datetime]'{cutoff:%Y-%m-%d}' }} |
    ForEach-Object {{
      foreach ($line in [IO.File]::ReadLines($_.FullName)) {{
        if ($line.Contains('"type":"assistant"')) {{ [Console]::Out.WriteLine($line) }}
      }}
    }}
}}
"""


def posix_script(cutoff: datetime) -> str:
    return (
        'd="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"; [ -d "$d" ] || exit 0; '
        f"find \"$d\" -name '*.jsonl' -newermt '{cutoff:%Y-%m-%d}' "
        "-exec grep -h '\"type\":\"assistant\"' {} +; true"
    )


def ssh(host: str, command: str) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-C", host, command],
        capture_output=True,
        check=False,
    )


def remote_lines(host: str, cutoff: datetime) -> Iterator[str]:
    # cmd.exe expands %OS% to Windows_NT; POSIX shells print it unchanged.
    probe = ssh(host, "echo %OS%")
    if probe.returncode != 0:
        sys.exit(f"tokens: cannot SSH to {host}: {probe.stderr.decode(errors='replace').strip()}")
    is_windows = b"Windows_NT" in probe.stdout
    if is_windows:
        encoded = base64.b64encode(windows_script(cutoff).encode("utf-16-le")).decode()
        result = ssh(host, f"powershell -NoProfile -NonInteractive -EncodedCommand {encoded}")
    else:
        result = ssh(host, posix_script(cutoff))
    if result.returncode != 0:
        sys.exit(f"tokens: reading logs on {host} failed: {result.stderr.decode(errors='replace').strip()[-500:]}")
    yield from result.stdout.decode("utf-8", errors="replace").splitlines()


def local_lines(cutoff: datetime) -> Iterator[str]:
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / "projects"
    for path in root.rglob("*.jsonl"):
        if datetime.fromtimestamp(path.stat().st_mtime).astimezone() < cutoff:
            continue
        with path.open(encoding="utf-8", errors="replace") as f:
            yield from (line for line in f if '"type":"assistant"' in line)


def collect(lines: Iterable[str], since: datetime) -> list[Reply]:
    replies: dict[str, Reply] = {}
    for line in lines:
        reply = parse_reply(line)
        if reply and reply.when >= since:
            replies[reply.key] = reply
    return sorted(replies.values(), key=lambda r: r.when)


def group_key(reply: Reply, by: str) -> str:
    if by == "day":
        return reply.when.strftime("%Y-%m-%d %a")
    if by == "model":
        return reply.model
    if by == "session":
        return f"{reply.session[:8]} {reply.project}"
    return reply.project


def aggregate(replies: list[Reply], by: str) -> dict[str, Totals]:
    groups: dict[str, Totals] = {}
    for reply in replies:
        groups.setdefault(group_key(reply, by), Totals()).add(reply)
    return groups


def human(n: int) -> str:
    for unit, size in (("B", 1_000_000_000), ("M", 1_000_000), ("k", 1_000)):
        if n >= size:
            return f"{n / size:.1f}{unit}"
    return str(n)


def print_table(title: str, groups: dict[str, Totals], by: str) -> None:
    print(title)
    if not groups:
        print("  no Claude Code usage in this period\n")
        return
    header = (by, "replies", "input", "output", "cache write", "cache read", "total")
    rows = [
        (name, str(t.replies), human(t.input), human(t.output),
         human(t.cache_write), human(t.cache_read), human(t.total))
        for name, t in groups.items()
    ]
    overall = Totals()
    for t in groups.values():
        overall.merge(t)
    rows.append(
        ("TOTAL", str(overall.replies), human(overall.input), human(overall.output),
         human(overall.cache_write), human(overall.cache_read), human(overall.total))
    )
    widths = [max(len(row[i]) for row in [header, *rows]) for i in range(len(header))]

    def fmt(row: tuple[str, ...]) -> str:
        cells = zip(row, widths, strict=True)
        return "  " + "  ".join(c.ljust(w) if i == 0 else c.rjust(w) for i, (c, w) in enumerate(cells))

    print(fmt(header))
    for row in rows[:-1]:
        print(fmt(row))
    print("  " + "-" * (sum(widths) + 2 * (len(widths) - 1)))
    print(fmt(rows[-1]))
    print(f"  last reply: {overall.last:%Y-%m-%d %H:%M}\n")


def parse_since(value: str) -> datetime:
    today = datetime.now().astimezone().replace(hour=0, minute=0, second=0, microsecond=0)
    if value == "today":
        return today
    match = re.fullmatch(r"(\d+)([hd])", value)
    if match:
        amount, unit = int(match.group(1)), match.group(2)
        return datetime.now().astimezone() - (timedelta(hours=amount) if unit == "h" else timedelta(days=amount))
    try:
        return datetime.strptime(value, "%Y-%m-%d").astimezone()
    except ValueError:
        raise argparse.ArgumentTypeError("use today, 12h, 7d or YYYY-MM-DD") from None


def report(hosts: list[str], since: datetime, by: str, as_json: bool) -> None:
    # Files untouched since a day before the cutoff cannot hold newer replies.
    file_cutoff = since - timedelta(days=1)
    output: dict[str, dict[str, dict[str, int | str]]] = {}
    for host in hosts or ["local"]:
        lines = local_lines(file_cutoff) if host == "local" else remote_lines(host, file_cutoff)
        groups = aggregate(collect(lines, since), by)
        if as_json:
            output[host] = {
                name: {"replies": t.replies, "input": t.input, "output": t.output, "cache_write": t.cache_write,
                       "cache_read": t.cache_read, "total": t.total, "last": t.last.isoformat()}
                for name, t in groups.items()
            }
        else:
            print_table(f"{host}: Claude Code tokens since {since:%Y-%m-%d %H:%M}", groups, by)
    if as_json:
        print(json.dumps(output, indent=2))


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="tokens",
        description="Show Claude Code token usage on this machine or on mesh machines over SSH.",
    )
    parser.add_argument("hosts", nargs="*", help="SSH hosts to check; 'local' or nothing means this machine")
    parser.add_argument("--since", type=parse_since, default="7d", help="today, 12h, 7d (default) or YYYY-MM-DD")
    parser.add_argument("--by", choices=GROUPINGS, default="day", help="how to group rows (default: day)")
    parser.add_argument("--json", action="store_true", help="print JSON instead of tables")
    parser.add_argument("--watch", type=int, metavar="SECONDS", help="refresh every SECONDS until Ctrl+C")
    args = parser.parse_args()
    since = args.since if isinstance(args.since, datetime) else parse_since(args.since)

    if args.watch is None:
        report(args.hosts, since, args.by, args.json)
        return
    try:
        while True:
            print("\033[2J\033[H", end="")
            report(args.hosts, since, args.by, args.json)
            print(f"refreshing every {args.watch}s, Ctrl+C to stop")
            time.sleep(args.watch)
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
